; Brick 3 AMU configuration. Copy to global.ini and fill in for this unit.
; global.ini is git-ignored (holds site WLAN credentials); only this .example
; is committed. Certificates live in ../pki (installed by the provisioning step),
; never in this file.

[NETWORK]
device_id = AMU_01
wifi_ssid = YOUR_WLAN_SSID
wifi_pass = YOUR_WLAN_PASSWORD
; Fixed server address for the DTLS session (the residence has one server).
server_host = 192.168.0.112
target_port = 11400
; Port the AMU listens on for direct live MCP queries (mains-powered AMU only).
live_port = 5001

[SECURITY]
; Directory holding ca-cert.pem, <device_id>-cert.pem and <device_id>-key.pem.
pki_dir = /home/omega/omega_amu/pki

[PATHS]
buffer_file = /home/omega/omega_amu/offline_buffer.json

[TRIGGER_THRESHOLDS]
alarm_heartbeat_interval = 1800
co2_critical_high = 1400
pm_critical_high = 55
temp_critical_high = 30
temp_critical_low = 12
hum_critical_high = 70
hum_critical_low = 25
lux_critical_high = 800
lux_critical_low = 5
co2_delta = 150
pm_delta = 15
temp_step = 1.5
hum_step = 5
lux_step = 100

; --- Hysteresis: the value an alarm clears at ---------------------------
; An alarm latches when a limit is crossed and lifts at a LOWER one, so a
; reading hovering on the limit cannot flap between states. Leave a clear
; value out and the trip value is used for both, which leaves only the
; timing deadband below - the unit still works, it just flaps more.
co2_critical_clear = 1300
pm_critical_clear = 45
temp_critical_high_clear = 29
temp_critical_low_clear = 13
hum_critical_high_clear = 67
hum_critical_low_clear = 28
lux_critical_high_clear = 750
lux_critical_low_clear = 8

; --- Hysteresis: the time an alarm must hold ----------------------------
; Slow to raise, slower to drop. A limit must be crossed continuously for
; alarm_sustain_s before the alarm latches, and released continuously for
; alarm_clear_s before it lifts.
alarm_sustain_s = 60
alarm_clear_s = 120
; A latched alarm re-announces on its own clock, independent of the
; heartbeat, so raising the heartbeat to quieten a chatty site cannot also
; quieten its alarms.
alarm_repeat_s = 300
; Floor between change-driven records. Alarms are not subject to it.
min_send_interval_s = 60
